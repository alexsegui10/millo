# Environment Variables - OFM Agency Hub

## Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ofm_agency_hub

## Server
PORT=3000
NODE_ENV=development

## Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
BCRYPT_ROUNDS=12

## CORS - Allowed Origins (comma-separated)
# Development: uses localhost automatically
# Production: set to your frontend domain(s)
ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

## Client URL (for redirects, emails, etc.)
CLIENT_URL=http://localhost:5173

## Logging
LOG_LEVEL=info

## Rate Limiting (optional, uses defaults if not set)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

## Feature Flags (optional)
ENABLE_AUDIT_LOG=false
ENABLE_METRICS_DASHBOARD=true

## External Services (if applicable)
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

## Email (if applicable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
